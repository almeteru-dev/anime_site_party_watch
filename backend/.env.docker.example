# Backend Environment Variables for Docker (.env.docker)

IS_PRODUCTION=true
PORT=8080

FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:8081

ALLOWED_ORIGINS=http://localhost:8081

COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=auto

JWT_SECRET=change-me

