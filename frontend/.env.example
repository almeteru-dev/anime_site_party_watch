# Frontend Environment Variables (.env)
# ------------------------------------

# (Required in Production) The public-facing URL of the Next.js site.
# Used to resolve absolute paths for server-side fetching and auth logic.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# (Required in Production) The internal URL of the Go Backend API.
# Used by Next.js server (Middleware and Rewrites) to securely proxy requests to the backend.
# Usually this is internal (e.g., http://backend:8080/api)
BACKEND_API_URL=http://localhost:8080/api

# (Optional) Public API URL if not using rewrites. Usually not needed because of proxy.
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api
